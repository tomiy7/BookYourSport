{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "search-route": {
        "ClusterId": "search-cluster",
        "Match": {
          "Path": "/search/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/search"
          }
        ]
      },

      "reservation-route": {
        "ClusterId": "reservation-cluster",
        "Match": {
          "Path": "/reservation/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/reservation"
          }
        ]
      },

      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/payment/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/payment"
          }
        ]
      },

      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },

      "contracts-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/contracts/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "search-cluster": {
        "Destinations": {
          "search-destination": {
            "Address": "http://search_api:8080/"
          }
        }
      },

      "reservation-cluster": {
        "Destinations": {
          "reservation-destination": {
            "Address": "http://reservation.api:8080/"
          }
        }
      },

      "payment-cluster": {
        "Destinations": {
          "payment-destination": {
            "Address": "http://payment_api:8080/"
          }
        }
      },

      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://auth_api:8080/"
          }
        }
      }
    }
  }
}